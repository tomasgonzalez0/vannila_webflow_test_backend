# PostgreSQL connection. Set as a secret in the deployment provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Exact comma-separated browser origins. Never use * in production.
ALLOWED_ORIGINS=https://vannila-studio.webflow.io

# Owner-confirmed HH:MM values only. These examples are DEMO values.
BOOKING_SLOTS=09:00,13:00,17:00

# Keep demo until the owner confirms the real slot schedule.
BOOKING_MODE=demo

# Required in demo mode for controlled API tests. Do not expose in Webflow JS.
DEMO_BOOKING_KEY=replace-with-a-secret

# Required in production mode for signed, short-lived booking challenges.
# Generate at least 32 random bytes and store only in the deployment provider.
BOOKING_CHALLENGE_SECRET=replace-with-at-least-32-random-bytes
