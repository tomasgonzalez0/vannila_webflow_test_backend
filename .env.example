# PostgreSQL connection. Set as a secret in the deployment provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Exact comma-separated browser origins. Never use * in production.
ALLOWED_ORIGINS=https://vannila-studio.webflow.io

# Owner-confirmed HH:MM values only. These examples are DEMO values.
BOOKING_SLOTS=09:00,13:00,17:00

# Keep demo until the owner confirms the real slot schedule.
BOOKING_MODE=demo

# Required in demo mode for controlled API tests. Do not expose in Webflow JS.
DEMO_BOOKING_KEY=replace-with-a-secret

# Required in production mode. Set securely; never commit the real value.
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret

# Optional public metadata used only by the Webflow widget integration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key

# Development/test escape hatch. Refused when NODE_ENV=production.
SKIP_ANTI_ABUSE=false
